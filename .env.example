# Server
PORT=8080
GIN_MODE=debug

# Database (default is domain_manager.db; local example uses domain.db)
DB_PATH=domain.db

# JWT (REQUIRED in production: generate with `openssl rand -hex 32` and keep it secret.
# If unset, a random key is generated at startup and all sessions expire on restart.)
JWT_KEY=change-this-to-a-long-random-string-at-least-32-bytes

# WHOIS API (self-hosted next-whois: https://github.com/zmh-program/next-whois)
WHOIS_API_URL=https://who.zmh.me

# ICP API (self-hosted icp-query: https://github.com/HG-ha/ICP_Query)
ICP_API_URL=http://127.0.0.1:16181
