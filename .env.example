# Server (infrastructure — NOT stored in the database)
PORT=8080
GIN_MODE=debug

# Database (infrastructure — NOT stored in the database)
DB_PATH=domain.db

# JWT (infrastructure secret — NOT stored in the database. Generate with
# `openssl rand -hex 32` and keep it secret. If unset, a random key is
# generated at startup and all sessions expire on restart.)
JWT_KEY=change-this-to-a-long-random-string-at-least-32-bytes